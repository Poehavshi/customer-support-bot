# Copy to .env and fill in. .env is git-ignored; this file lists every variable the project reads.

# Anthropic API key used by the Support Agent for model calls.
ANTHROPIC_API_KEY=

# Optional. Base URL of an Anthropic-compatible gateway such as a LiteLLM proxy, without a /v1 suffix.
# Leave empty to call api.anthropic.com directly.
ANTHROPIC_BASE_URL=

# PostgreSQL connection string for the Order Store (matches the compose service and the CI service container).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/support_agent

# Model id and effort level the Support Agent runs with; both are recorded in every eval report.
# Effort is one of Anthropic's levels (low, medium, high, max) or "default" to leave it unset.
SUPPORT_AGENT_MODEL=claude-opus-5
SUPPORT_AGENT_EFFORT=default
